# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback

# Server Configuration
PORT=3003
NODE_ENV=development

# Database Configuration (para almacenar tokens)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Logging
LOG_LEVEL=info

# MCP Configuration
MCP_SERVER_NAME=google-mcp
MCP_SERVER_VERSION=1.0.0

# Google API Scopes
GOOGLE_SCOPES=gmail.readonly,calendar.readonly,drive.readonly,calendar.events

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here 